# Copy to .env for local development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# postgres://user:password@host:port/database
DATABASE_URL=postgres://joinly:joinly@localhost:5432/joinly
# Used by the integration tests only. They run migrations against it and truncate tables.
TEST_DATABASE_URL=postgres://joinly:joinly@localhost:5432/joinly_test

# HS256 signing key for access tokens, at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth "Web application" client ID; the audience of the ID tokens the app sends.
# Comma-separate several if needed (e.g. web + iOS).
GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Lifetime of a classroom join code.
JOIN_CODE_TTL_HOURS=24

# Enables POST /v1/auth/demo (seeded reviewer accounts). Keep false in production.
DEMO_LOGIN_ENABLED=false

# Number of reverse proxies in front of the API (Railway: 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0

# Contact shown on the public privacy policy page (GET /privacy), required by Google's OAuth consent screen.
SUPPORT_EMAIL=
